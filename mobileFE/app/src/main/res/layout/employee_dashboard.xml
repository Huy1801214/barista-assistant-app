<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray_background"
    tools:context=".activity.EmployeeDashboardActivity"> <!-- Thay bằng tên Activity của bạn -->

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarEmployee"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/orange_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/imageViewEmployeeAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_person_placeholder"
            app:tint="@color/white"
            android:background="@drawable/circle_background_green"
            android:padding="4dp"
            android:contentDescription="@string/employee_name_placeholder"/>

        <TextView
            android:id="@+id/textViewEmployeeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/employee_name_placeholder"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/imageViewFlag"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:src="@drawable/circle_background_green"
            android:scaleType="fitCenter"
            android:layout_marginEnd="16dp"/>

        <ImageView
            android:id="@+id/imageViewNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/circle_background_green"
            app:tint="@color/white"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarEmployee"
        android:layout_above="@+id/bottomNavigationViewEmployee">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Grid Layout for Functions -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridLayoutFunctions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:rowCount="2"
                app:useDefaultMargins="false"
                app:alignmentMode="alignBounds"
                app:rowOrderPreserved="false"
                tools:ignore="MissingClass">

                <!-- Tại quầy -->
                <include layout="@layout/grid_item_function"
                    android:id="@+id/itemAtCounter"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Báo cáo -->
                <include layout="@layout/grid_item_function"
                    android:id="@+id/itemReports"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Đồng bộ -->
                <include layout="@layout/grid_item_function"
                    android:id="@+id/itemSync"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <!-- Thêm -->
                <include layout="@layout/grid_item_function"
                    android:id="@+id/itemAddMore"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

            </androidx.gridlayout.widget.GridLayout>

            <!-- Help Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/need_help_title"
                            android:textColor="@color/dark_gray_text"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/need_help_subtitle"
                            android:textColor="@color/light_gray_text"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.2"/>
                    </LinearLayout>

<!--                    <Button-->
<!--                        android:id="@+id/buttonContact"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginStart="16dp"-->
<!--                        android:text="@string/contact_us"-->
<!--                        app:icon="@drawable/ic_chat_bubble"-->
<!--                        android:backgroundTint="@color/blue_accent"-->
<!--                        android:textColor="@color/white"-->
<!--                        app:iconTint="@color/white"-->
<!--                        style="@style/Widget.MaterialComponents.Button"/>-->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationViewEmployee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@drawable/bottom_nav_icon_color_selector"
        app:itemTextColor="@drawable/bottom_nav_icon_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/employee_bottom_nav_menu"
        app:elevation="8dp"/>

</RelativeLayout>