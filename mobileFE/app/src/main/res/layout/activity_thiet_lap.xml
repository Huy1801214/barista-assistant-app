<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.ThietLapActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/orange_primary"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thiết lập"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nút Đăng xuất -->
    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/status_expired"
        android:text="Đăng xuất"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <!-- Nội dung có thể cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buttonLogout"
        android:layout_below="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thông tin nhân viên -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textViewUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="NHÂN VIÊN 1" />

                <TextView
                    android:id="@+id/textViewStoreAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="H349 - 8/2C Nguyễn Du, Khu Phố 1, P.Bửu Long..." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gói vĩnh viễn"
                    android:textColor="@color/orange_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nhóm Thiết lập chung -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/light_gray_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="THIẾT LẬP CHUNG"
                android:textColor="@color/dark_gray_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llThietLapMenu"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/restaurant" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Thiết lập menu" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llQuanLyNhanVien"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/profile" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Quản lý nhân viên" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llQuanLyVoucher"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/discount_coupon" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Quản lý voucher" />
            </LinearLayout>

            <!-- Nhóm Quản lý hoạt động -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/light_gray_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="QUẢN LÝ HOẠT ĐỘNG"
                android:textColor="@color/dark_gray_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llQuanLyCaLamViec"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/shift" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Quản lý ca làm việc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLichSuChamCong"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/ic_history" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Lịch sử chấm công" />
            </LinearLayout>

            <!-- Nhóm Tích hợp -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/light_gray_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="TÍCH HỢP"
                android:textColor="@color/dark_gray_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llConnectGoogleCalendar"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/ic_google_calendar" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Kết nối Google Calendar" />
            </LinearLayout>

            <!-- Nhóm Tài khoản -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/light_gray_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="TÀI KHOẢN"
                android:textColor="@color/dark_gray_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llThietLapTaiKhoan"
                style="@style/SettingsMenuItemContainer">

                <ImageView
                    style="@style/SettingsMenuIcon"
                    android:src="@drawable/user" />

                <TextView
                    style="@style/SettingsMenuText"
                    android:text="Thiết lập tài khoản" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>