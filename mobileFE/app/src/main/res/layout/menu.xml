<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray_background"
    tools:context=".activity.MenuActivity">

    <!-- === TOP BAR === -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/orange_primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/imageViewBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/imageViewAction1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_1"
            android:padding="8dp"
            android:src="@drawable/ic_placeholder_24dp"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/imageViewAction2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_2"
            android:padding="8dp"
            android:src="@drawable/ic_placeholder_24dp"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/imageViewAction3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_3"
            android:padding="8dp"
            android:src="@drawable/ic_placeholder_24dp"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- === SECONDARY ACTION BAR === -->
    <LinearLayout
        android:id="@+id/secondaryActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/imageViewGift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/gift"
                android:src="@drawable/ic_gift"
                app:tint="@color/orange_primary"
                tools:ignore="ImageContrastCheck" />

            <TextView
                android:id="@+id/textViewVoucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voucher"
                android:textColor="@color/orange_primary"
                android:textSize="16sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textViewSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:drawablePadding="6dp"
            android:text="@string/search"
            android:textColor="@color/dark_gray_text"
            app:drawableStartCompat="@drawable/ic_search" />

        <TextView
            android:id="@+id/textViewQuickAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:drawablePadding="6dp"
            android:text="@string/quick_add"
            android:textColor="@color/dark_gray_text"
            app:drawableStartCompat="@drawable/ic_add" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textViewStore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:text="@string/at_store"
            android:textColor="@color/dark_gray_text"
            app:drawableStartCompat="@drawable/ic_store" />
    </LinearLayout>

    <!-- === MAIN CONTENT: Categories and Products === -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/bottomBar"
        android:layout_below="@id/secondaryActionBar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:background="@color/white"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_category_placeholder" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="6"
            tools:listitem="@layout/item_product_placeholder" />
    </LinearLayout>


    <!-- === BOTTOM BAR === -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:id="@+id/totalAmountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/textViewTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/total_amount"
                android:textColor="@color/dark_gray_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewTotalAmountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/textViewTotalLabel"
                android:layout_marginStart="8dp"
                android:text="0"
                android:textColor="@color/orange_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewTakeAway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Mang đi"
                android:textColor="@color/orange_primary"
                android:textSize="14sp"
                android:drawableTop="@drawable/ic_take_away"
                android:gravity="center"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/actionButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/imageButtonCart"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/orange_primary"
                android:contentDescription="Giỏ hàng"
                android:src="@drawable/ic_cart"
                app:tint="@color/white" />

            <Button
                android:id="@+id/buttonWaitingCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/button_gray"
                android:text="Thẻ chờ"
                android:textColor="@color/dark_gray_text" />

            <Button
                android:id="@+id/buttonPayment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/button_gray"
                android:text="T.Toán"
                android:textColor="@color/dark_gray_text" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>